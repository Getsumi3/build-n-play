{
    "trailingComma": "none",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "printWidth": 100,
    "bracketSpacing": true,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.scss", "*.css", "*.json"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
